@startuml

package "Domain" {

  class Mission {
    - missionId : String
    - date : java.time.LocalDate
    - location : String
    - outcome : MissionOutcome
    - damageCost : long
    - curse : Curse
    - sorcerers : java.util.List<Sorcerer>
    - techniques : java.util.List<TechniqueUsage>
    - comment : String
  }

  class Curse {
    - name : String
    - threatLevel : ThreatLevel
  }

  class Sorcerer {
    - name : String
    - rank : SorcererRank
  }

  class Technique {
    - name : String
    - type : TechniqueType
  }

  class TechniqueUsage {
    - technique : Technique
    - owner : Sorcerer
    - damage : long
  }

  enum MissionOutcome {
    SUCCESS
    FAILURE
    PARTIAL
  }

  enum ThreatLevel {
    LOW
    MEDIUM
    HIGH
    SPECIAL_GRADE
  }

  enum SorcererRank {
    GRADE_4
    GRADE_3
    GRADE_2
    GRADE_1
    SEMI_GRADE_1
    SPECIAL_GRADE
  }

  enum TechniqueType {
    INNATE
    SHIKIGAMI
  }

  Mission "1" --> "1" Curse : curse
  Mission "1" --> "*" Sorcerer : sorcerers
  Mission "1" --> "*" TechniqueUsage : techniques

  TechniqueUsage "*" --> "1" Technique : technique
  TechniqueUsage "*" --> "1" Sorcerer : owner

}

package "Parsing & IO" {

  abstract MissionParser {
    + parse(file : java.nio.file.Path) : Mission
    + parseLongSafe(raw : String) : long
    + parseLongSafe(raw : String, defaultValue : long) : long
    + parseOutcome(raw : String) : MissionOutcome
    + parseThreatLevel(raw : String) : ThreatLevel
    + parseSorcererRank(raw : String) : SorcererRank
    + parseTechniqueType(raw : String) : TechniqueType
    + findSorcererByName(list : List<Sorcerer>, name : String) : Sorcerer
  }

  class JsonMissionParser {
    - mapper : ObjectMapper

    + getText(node : JsonNode, field : String, required : boolean) : String
  }
  class XmlMissionParser {
    + getTextContent(parent : Element, tag : String, required : boolean) : String
  }
  class TextMissionParser{
    + parseArrayInLine(node : JsonNode, field : String, required : boolean) : String
   }

  class MissionParserFactory {
    + getParser(file : java.nio.file.Path) : MissionParser
  }

  class MissionParsingException extends Exception

  class MissionPrinter {
    + print(mission : Mission, out : PrintStream) : void
    + safe(o : Object) : String
  }

  class MissionAnalyzerApp {
    + main(args : String[]) : void
  }

  MissionParser <|.. JsonMissionParser
  MissionParser <|.. XmlMissionParser
  MissionParser <|.. TextMissionParser

  MissionParserFactory --> MissionParser
  MissionPrinter --> Mission
  MissionAnalyzerApp --> MissionParserFactory
  MissionAnalyzerApp --> MissionPrinter
}

@enduml